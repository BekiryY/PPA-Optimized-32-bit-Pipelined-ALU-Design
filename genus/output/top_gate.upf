	 -ports VSS

set_domain_supply_net PD_GLOBAL \
	 -primary_power_net VDD \
	 -primary_ground_net VSS

create_power_domain PD_MOD_0 \
	 -elements adder

create_supply_net VDD_V_0 \
	 -domain PD_MOD_0

set_domain_supply_net PD_MOD_0 \
	 -primary_power_net VDD_V_0 \
	 -primary_ground_net VSS

create_power_switch PS_0 \
	 -domain PD_MOD_0 \
	 -input_supply_port { vin VDD } \
	 -output_supply_port { vout VDD_V_0 } \
	 -control_port { ctrl power_en_adder } \
	 -on_state { ON_STATE vin {ctrl} } \
	 -off_state { OFF_STATE {!ctrl} }

set_isolation ISO_0 \
	 -domain PD_MOD_0 \
	 -isolation_power_net VDD \
	 -isolation_ground_net VSS \
	 -clamp_value 0 \
	 -applies_to outputs

set_isolation_control ISO_0 \
	 -domain PD_MOD_0 \
	 -isolation_signal g2066/Y \
	 -isolation_sense low


upf_version 1.0

# =============================================================================
# 1. ALWAYS ON DOMAIN (The "Default Bucket")
# =============================================================================
# -include_scope puts everything NOT listed later into this domain.
# This automatically handles your top-level glue logic, FSMs, and power_en wires.
create_power_domain PD_TOP -include_scope
set_domain_supply_net PD_TOP -primary_power_pin VDD -primary_ground_pin VSS

# =============================================================================
# 2. GATED DOMAINS (Repeat this block for MOD_0 through MOD_5)
# =============================================================================

# --- MODULE 0 ---
create_power_domain PD_MOD_0 -elements {u_core/u_module_0} 
set_domain_supply_net PD_MOD_0 -primary_power_pin VDD_V_0 -primary_ground_pin VSS

# The Switch: Connects real VDD to virtual VDD_V_0
create_power_switch PS_0 \
    -domain PD_MOD_0 \
    -input_supply_port {vdd_in VDD} \
    -output_supply_port {vdd_out VDD_V_0} \
    -control_port {ctrl switch_ctrl_0} \ ------------------------------------------------
    -on_state {ON_STATE vdd_in {ctrl}} \
    -off_state {OFF_STATE { !ctrl }}

# The Isolation: Clamps outputs to 0 when power is off
set_isolation ISO_0 \
    -domain PD_MOD_0 \
    -isolation_power_net VDD \
    -isolation_ground_net VSS \
    -clamp_value 0 \
    -applies_to outputs

# The Control: When switch_ctrl_0 is LOW, activate isolation
set_isolation_control ISO_0 \
    -domain PD_MOD_0 \
    -isolation_signal switch_ctrl_0 \
    -isolation_sense low

# --- MODULE 1 ---
# (Copy paste above, change _0 to _1, VDD_V_0 to VDD_V_1, etc.)


# =============================================================================
# 3. CONNECTIVITY (Tie it all together)
# =============================================================================
# 1. Connect global ports to global nets
connect_supply_net VDD -ports {VDD}
connect_supply_net VSS -ports {VSS}

# 2. Connect the Virtual Nets to the Domain Ports
# This is required so Innovus knows "VDD_V_0" belongs to "PD_MOD_0"
connect_supply_net VDD_V_0 -ports {PD_MOD_0/VDD_V_0}
connect_supply_net VDD_V_1 -ports {PD_MOD_1/VDD_V_1}
connect_supply_net VDD_V_2 -ports {PD_MOD_2/VDD_V_2}
connect_supply_net VDD_V_3 -ports {PD_MOD_3/VDD_V_3}
connect_supply_net VDD_V_4 -ports {PD_MOD_4/VDD_V_4}
connect_supply_net VDD_V_5 -ports {PD_MOD_5/VDD_V_5}